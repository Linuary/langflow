# Langflow - 外部 Redis + PostgreSQL 配置

# PostgreSQL 外部数据库
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
LANGFLOW_DATABASE_URL=postgresql://postgres:123456@localhost:5433/langflow

# Redis 外部缓存
REDIS_HOST=localhost
REDIS_PORT=6379
LANGFLOW_REDIS_URL=redis://localhost:6379/0

# Langflow 管理员密码（必填）
LANGFLOW_SUPERUSER_PASSWORD=your-superuser-password
